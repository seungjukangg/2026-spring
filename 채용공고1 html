<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>30 Years of Recruitment Evolution</title>
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&family=Noto+Sans+KR:wght@400;700&display=swap" rel="stylesheet">
    <style>
        /* 기본 변수 설정 (JS에서 변경됨) */
        :root {
            --bg-color: #f4ede4; /* 아날로그 배경 */
            --text-color: #3e3b39; /* 아날로그 글자 */
            --font-family: 'Courier Prime', monospace;
            --kr-color: #2980b9;
            --us-color: #c0392b;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-family);
            margin: 0;
            padding: 0;
            transition: all 0.8s ease; /* 부드러운 화면 전환 */
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .dashboard {
            max-width: 900px;
            width: 100%;
            padding: 40px 20px;
        }

        header { text-align: center; margin-bottom: 40px; border-bottom: 2px dashed var(--text-color); padding-bottom: 20px; }
        
        /* 1. 타임 슬라이더 (Era Selector) */
        .slider-container { text-align: center; margin-bottom: 50px; padding: 20px; border: 1px solid var(--text-color); border-radius: 10px; }
        input[type="range"] { width: 80%; cursor: pointer; }
        .year-display { font-size: 2.5rem; font-weight: bold; margin-top: 10px; }

        /* 2. 회귀 분석 패널 (Statistical Narrative) */
        .stats-panel { background: rgba(0,0,0,0.05); padding: 20px; border-radius: 8px; margin-bottom: 40px; }
        .formula { font-size: 1.2rem; margin-bottom: 15px; font-weight: bold; }
        .beta-values { display: flex; justify-content: space-between; font-size: 0.9rem; }

        /* 3. 산 모양 시각화 (Visual Metaphor) */
        .mountain-container {
            display: flex; justify-content: space-around; align-items: flex-end;
            height: 350px; border-bottom: 3px solid var(--text-color); padding-bottom: 10px; margin-bottom: 40px;
            position: relative;
        }
        .mountain-wrapper { text-align: center; width: 40%; position: relative; }
        .mountain {
            width: 100%; transition: height 0.5s ease; cursor: help;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
        }
        .mt-kr { background-color: var(--kr-color); }
        .mt-us { background-color: var(--us-color); opacity: 0.85; }
        
        .edu-label { font-size: 1.2rem; font-weight: bold; margin-top: 10px; }

        /* 툴팁 */
        .tooltip {
            visibility: hidden; width: 200px; background-color: var(--text-color); color: var(--bg-color);
            text-align: center; border-radius: 6px; padding: 10px; position: absolute; z-index: 1;
            bottom: 110%; left: 50%; margin-left: -100px; opacity: 0; transition: opacity 0.3s;
            font-family: 'Noto Sans KR', sans-serif; font-size: 0.85rem;
        }
        .mountain:hover .tooltip { visibility: visible; opacity: 1; }

        /* 4. 심리적 키워드 패널 */
        .keyword-panel { text-align: center; }
        .keywords { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 15px; }
        .keyword { padding: 8px 15px; border: 1px solid var(--text-color); border-radius: 20px; transition: transform 0.2s; }
        .keyword:hover { transform: scale(1.1); background-color: var(--text-color); color: var(--bg-color); }
    </style>
</head>
<body>

<div class="dashboard">
    <header>
        <h1>한·미 채용 시장 진화 대시보드</h1>
        <p>통계와 언어로 본 30년의 서사 (1996 - 2026)</p>
    </header>

    <div class="slider-container">
        <label for="yearSlider">시대를 탐색하세요 (Drag to time travel)</label><br><br>
        <input type="range" id="yearSlider" min="1996" max="2026" value="1996">
        <div class="year-display" id="currentYear">1996</div>
    </div>

    <div class="stats-panel">
        <div class="formula">회귀 모델: Y(요구 학력 연수) = β0 + β1(국가) + β2(연도) + β3(국가×연도)</div>
        <div class="beta-values">
            <span id="gapText">👉 미국 대비 한국의 요구 학력 격차(β1 효과): <b>0.0년</b></span>
            <span>상호작용항(β3) P-value: <b style="color: #c0392b;">&lt; 0.01</b> (유의함)</span>
        </div>
    </div>

    <div class="mountain-container">
        <div class="mountain-wrapper">
            <div class="mountain mt-us" id="usMountain" style="height: 120px;">
                <span class="tooltip" id="usTooltip">1996년 미국: 닷컴 버블 이전의 유연한 채용</span>
            </div>
            <div class="edu-label">미국 (USA, x=0)<br><span id="usEdu">12.0년 (고졸)</span></div>
        </div>

        <div class="mountain-wrapper">
            <div class="mountain mt-kr" id="krMountain" style="height: 120px;">
                <span class="tooltip" id="krTooltip">1996년 한국: 외환위기 직전, 종이 이력서와 인맥 중심</span>
            </div>
            <div class="edu-label">한국 (KOR, x=1)<br><span id="krEdu">12.0년 (고졸)</span></div>
        </div>
    </div>

    <div class="keyword-panel">
        <h3>당시 공고문에 나타난 심리적 키워드</h3>
        <div class="keywords" id="keywordBox">
            </div>
    </div>
</div>

<script>
    // 1. 요소 가져오기
    const slider = document.getElementById('yearSlider');
    const yearDisplay = document.getElementById('currentYear');
    const usMountain = document.getElementById('usMountain');
    const krMountain = document.getElementById('krMountain');
    const usEdu = document.getElementById('usEdu');
    const krEdu = document.getElementById('krEdu');
    const gapText = document.getElementById('gapText');
    const krTooltip = document.getElementById('krTooltip');
    const usTooltip = document.getElementById('usTooltip');
    const keywordBox = document.getElementById('keywordBox');

    // 2. 시대별 데이터 세팅 (통계치 시뮬레이션)
    const keywordsByEra = {
        1990: ["#성실함", "#평생직장", "#가족같은분위기", "#인내심", "#수기공고", "#인맥"],
        2000: ["#글로벌마인드", "#외국어우대", "#열정페이", "#인터넷활용", "#도전정신"],
        2010: ["#스펙", "#토익필수", "#유관경험", "#창의적인재", "#팀워크"],
        2020: ["#데이터기반", "#애자일", "#AI협업", "#성과주의", "#석사우대", "#코딩역량"]
    };

    // 3. 슬라이더 움직일 때마다 실행되는 함수
    slider.addEventListener('input', function() {
        const year = parseInt(this.value);
        yearDisplay.innerText = year;

        // 시간에 흐름(t) 계산 (0 ~ 30)
        const t = year - 1996;

        // 회귀식 기반 가상 데이터 산출 (Y = 요구 학력 연수)
        // 미국은 완만하게 증가, 한국은 IMF 이후 상호작용항(b3)에 의해 가파르게 증가
        let usY = 12.0 + (t * 0.1); 
        let krY = 12.0 + (t * 0.25); // 한국 기울기가 더 가파름

        // 화면 갱신: 산 높이 조절 (px 단위로 변환)
        usMountain.style.height = (usY * 12) + "px";
        krMountain.style.height = (krY * 12) + "px";

        // 화면 갱신: 학력 텍스트 조절
        usEdu.innerText = usY.toFixed(1) + "년 (" + getEduLevel(usY) + ")";
        krEdu.innerText = krY.toFixed(1) + "년 (" + getEduLevel(krY) + ")";

        // 격차 계산 (지시변수 효과 시각화)
        let gap = (krY - usY).toFixed(1);
        gapText.innerHTML = `👉 미국 대비 한국의 학력 요구 격차(β1 효과): <b>+${gap}년</b>`;

        // 아날로그 -> 디지털 테마 변환 로직 (2010년 기점으로 폰트 및 배경 전환)
        const root = document.documentElement;
        if (year >= 2010) {
            let darkness = (year - 2010) / 16; // 0 ~ 1 사이 값
            root.style.setProperty('--bg-color', `rgba(20, 20, 25, ${darkness + 0.1})`);
            root.style.setProperty('--text-color', darkness > 0.5 ? '#58a6ff' : '#3e3b39');
            root.style.setProperty('--font-family', "'Noto Sans KR', sans-serif");
        } else {
            root.style.setProperty('--bg-color', '#f4ede4');
            root.style.setProperty('--text-color', '#3e3b39');
            root.style.setProperty('--font-family', "'Courier Prime', monospace");
        }

        // 툴팁 및 키워드 업데이트
        updateContext(year);
    });

    // 학력 수치에 따른 한글 라벨링 함수
    function getEduLevel(years) {
        if(years < 14) return "전문학사 이하";
        if(years < 16) return "학사 우대";
        if(years < 18) return "학사 필수";
        return "석/박사 우대";
    }

    // 시대별 문맥(툴팁, 키워드) 업데이트 함수
    function updateContext(year) {
        // 툴팁 업데이트
        if(year < 2000) {
            krTooltip.innerText = "1997년 IMF 외환위기 발생: 평생직장의 개념 붕괴";
            usTooltip.innerText = "닷컴 버블 시기: 학위보다 실무 코딩 능력 중시";
        } else if (year < 2010) {
            krTooltip.innerText = "스펙 인플레이션의 시작: 대졸 공채 전성시대";
            usTooltip.innerText = "2008년 금융위기: 안정적인 학위 선호도 일시 증가";
        } else if (year < 2020) {
            krTooltip.innerText = "모바일 혁명: 이과 쏠림 현상 및 학점/어학 한계치 도달";
            usTooltip.innerText = "실리콘밸리 붐: 스탠퍼드 등 명문대 CS 석사 수요 급증";
        } else {
            krTooltip.innerText = "코로나 팬데믹 및 AI 쇼크: 신입 채용 축소, 고학력 경력직 선호";
            usTooltip.innerText = "생성형 AI 시대: 단순 코더 배제, 연구(PhD) 인력 우대";
        }

        // 키워드 업데이트
        let era = Math.floor(year / 10) * 10;
        if(era === 1990 && year >= 1996) era = 1990;
        if(era >= 2020) era = 2020;
        
        keywordBox.innerHTML = "";
        keywordsByEra[era].forEach(kw => {
            let span = document.createElement('span');
            span.className = 'keyword';
            span.innerText = kw;
            keywordBox.appendChild(span);
        });
    }

    // 초기화: 스크립트 로드 시 1996년 상태로 세팅
    slider.dispatchEvent(new Event('input'));
</script>

</body>
</html>
